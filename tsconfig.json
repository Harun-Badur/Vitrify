{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["jest", "node"],
    "customConditions": ["react-native", "react-native-legacy-deep-imports"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "reports/release/**/supabase/functions/**",
    "scripts",
    "supabase/functions",
    "node_modules",
    "tmp",
    ".tmp"
  ]
}
